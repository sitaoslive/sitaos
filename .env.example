# ==============================================================================
# ALPHA VISION AI SALES OS - ENVIRONMENT CONFIGURATION
# Copy to .env and configure verified API credentials before live deployment.
# ==============================================================================

SALES_OS_ENV=production
TARGET_MONTHLY_NET_PROFIT_USD=50000.0

# 1. AI COGNITIVE REASONING (CLAUDE API - ANTHROPIC)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL_DEEP_REASONING=claude-3-5-sonnet-20241022
CLAUDE_MODEL_FAST_TRIAGE=claude-3-5-haiku-20241022

# 2. COMMERCIAL REVENUE CRM (GOHIGHLEVEL)
# Get from: GHL Settings -> Developers -> Private Integrations / OAuth
GHL_API_KEY=your_ghl_private_integration_token_here
GHL_LOCATION_ID=your_ghl_subaccount_location_id_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_CALENDAR_ONBOARDING_ID=cal_avm_onboarding_master

# 3. APPLICATION & MULTI-TENANT DATABASE (SUPABASE)
# Project ID: djtejmrzxfkctbvpdkbg
SUPABASE_URL=https://djtejmrzxfkctbvpdkbg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 4. WORKFLOW ORCHESTRATION BUS (n8n CLOUD)
N8N_BASE_URL=https://alphavision.app.n8n.cloud
N8N_LOCAL_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_KEY=your_n8n_api_key_here

# 5. PAYMENT GATEWAYS & DEPOSIT PROCESSING
# Stripe (USD / CAD recurring subscriptions)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Wompi & MercadoPago (Colombia COP & Mexico MXN checkouts)
WOMPI_PUBLIC_KEY=pub_prod_your_wompi_public_key
WOMPI_PRIVATE_KEY=prv_prod_your_wompi_private_key
MERCADOPAGO_ACCESS_TOKEN=APP_USR_your_mercadopago_token

# 6. COLD EMAIL & MESSAGING DISPATCH
SMARTLEAD_API_KEY=your_smartlead_api_key_here
WHATSAPP_TOKEN=your_meta_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 7. CAMPAIGN SAFETY & TCPA CONTROLS
MAX_OUTREACH_PER_DAY=100
MAX_FOLLOWUPS_PER_CONTACT=3
TCPA_QUIET_HOURS_START=20
TCPA_QUIET_HOURS_END=8
KILL_SWITCH_ACTIVE=false
