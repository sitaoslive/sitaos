[Unit]
Description=Alpha Vision SaaS Control Plane & Revenue OS (FastAPI)
After=network.target

[Service]
User=alphavision
Group=alphavision
WorkingDirectory=/var/www/alphavision
Environment="PATH=/var/www/alphavision/venv/bin"
EnvironmentFile=/var/www/alphavision/.env
ExecStart=/var/www/alphavision/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 4 --log-level info
Restart=always
RestartSec=5s
StandardOutput=append:/var/log/alphavision/controlplane.log
StandardError=append:/var/log/alphavision/controlplane_error.log

# Security Sandboxing
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
